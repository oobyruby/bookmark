<?xml version="1.0" encoding="utf-8"?>

<!-- root container for the homepage and loading overlay -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:background="#BCA9CC">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="bookmark"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/search_bar_background"
            android:hint="search books, author, genre..."
            android:textColor="#333333"
            android:textColorHint="#88818D"
            android:textSize="11sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="6dp" />

    </LinearLayout>

    <!-- homepage content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="14dp">

            <!-- trending books -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="♨ trending books"
                    android:textColor="#333333"
                    android:textSize="14sp" />


                <TextView
                    android:id="@+id/seeAllTrending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="see all ›"
                    android:textColor="#444444"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trendingBooksRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="166dp"
                android:layout_marginBottom="18dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <!-- new releases -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✦ new releases"
                    android:textColor="#333333"
                    android:textSize="14sp" />


                <TextView
                    android:id="@+id/seeAllNewReleases"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="see all ›"
                    android:textColor="#444444"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />


            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/newReleasesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="166dp"
                android:layout_marginBottom="18dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <!-- stephen king collection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📚 stephen king collection"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/seeAllStephenKing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="see all ›"
                    android:textColor="#444444"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />

            </LinearLayout>

            <!-- horizontal list of stephen king books -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stephenKingRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="166dp"
                android:layout_marginBottom="18dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <!-- all-time favourites -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="♥ all-time favourites"
                    android:textColor="#333333"
                    android:textSize="14sp" />


                <TextView
                    android:id="@+id/seeAllFavourites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="see all ›"
                    android:textColor="#444444"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />


            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favouritesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="166dp"
                android:layout_marginBottom="18dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

    <!-- latest reviews -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▣ latest reviews"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/seeAllReviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="see all ›"
            android:textColor="#444444"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

    </LinearLayout>

    <!-- display the three most recent app reviews -->
    <LinearLayout
        android:id="@+id/homeReviewsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- shared bottom navigation -->
    <include
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="55dp" />

</LinearLayout>

    <!-- loading overlay displayed while the homepage books are retrieved -->
    <LinearLayout
        android:id="@+id/homeLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FCFAFD"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="visible">

        <!-- featured game of thrones book cover -->
        <ImageView
            android:layout_width="145dp"
            android:layout_height="215dp"
            android:src="@drawable/game_of_thrones_cover"
            android:scaleType="fitCenter"
            android:contentDescription="a game of thrones book cover" />

        <!-- app title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="bookmark"
            android:textColor="#69517D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- animated loading indicator -->
        <ProgressBar
            android:id="@+id/homeLoadingSpinner"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            android:indeterminateTint="#BCA9CC" />

        <!-- loading message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="finding your next read..."
            android:textColor="#826B94"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>

