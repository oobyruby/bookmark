<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/profile_list_background"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/currentBookCover"
        android:layout_width="85dp"
        android:layout_height="125dp"
        android:background="#E5D8E9"
        android:scaleType="centerCrop"
        android:contentDescription="Book cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/currentBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book title"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currentBookAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Author name"
            android:textColor="@color/textGrey"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading progress"
            android:textColor="@color/textGrey"
            android:textSize="11sp"
            android:layout_marginTop="12dp" />

        <ProgressBar
            android:id="@+id/currentBookProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="45"
            android:progressTint="@color/top_purple" />

        <TextView
            android:id="@+id/currentBookPercentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="45% completed"
            android:textColor="@color/textGrey"
            android:textSize="11sp"
            android:gravity="end" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/currentBookMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@drawable/verticaldots"
        android:contentDescription="Book options" />

</LinearLayout>