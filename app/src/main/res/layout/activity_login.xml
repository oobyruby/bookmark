<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E7DAF0"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- bookmark header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:background="#BCA9CC">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bookmark"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp">

            <!-- heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="welcome back"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="22dp" />

            <!-- email -->
            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/register_input_background"
                android:hint="email address"
                android:textSize="11sp"
                android:textColor="#554C5D"
                android:textColorHint="@color/register_hint"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:drawableStart="@drawable/ic_register_email"
                android:drawablePadding="6dp"
                android:drawableTint="@color/register_icon"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="9dp" />

            <!-- password -->
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/register_input_background"
                android:hint="password"
                android:textSize="11sp"
                android:textColor="#554C5D"
                android:textColorHint="@color/register_hint"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:drawableStart="@drawable/ic_register_lock"
                android:drawableEnd="@drawable/ic_register_eye"
                android:drawablePadding="6dp"
                android:drawableTint="@color/register_icon"
                android:inputType="textPassword"
                android:layout_marginBottom="18dp" />

            <!-- login button -->
            <TextView
                android:id="@+id/loginButton"
                android:layout_width="170dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="log in"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/register_button_background" />

            <!-- divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="31dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#CDBDD5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  or  "
                    android:textColor="#95869F"
                    android:textSize="10sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#CDBDD5" />

            </LinearLayout>

            <!-- google -->
            <TextView
                android:id="@+id/googleButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="continue with google"
                android:textColor="@color/register_hint"
                android:textSize="10sp"
                android:drawableStart="@drawable/ic_google"
                android:drawablePadding="6dp"
                android:background="@drawable/register_google_background" />

            <!-- register link -->
            <TextView
                android:id="@+id/registerLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="don't have an account? sign up here"
                android:textSize="10sp"
                android:textColor="#806F8B"
                android:layout_marginTop="17dp" />

        </LinearLayout>

    </ScrollView>

    <requestFocus />

</LinearLayout>
