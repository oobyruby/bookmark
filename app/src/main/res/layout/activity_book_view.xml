<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFCFE">

    <LinearLayout
        android:id="@+id/bookViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:background="#FFFCFE">

        <!-- back button -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="#44374D"
            android:background="@drawable/book_back_background"
            android:contentDescription="go back"
            android:clickable="true"
            android:focusable="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- book information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp">

                    <ImageView
                        android:id="@+id/bookCover"
                        android:layout_width="116dp"
                        android:layout_height="174dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/book_cover_description" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bookTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="book title"
                            android:textColor="#29232C"
                            android:textSize="23sp"
                            android:maxLines="3" />

                        <TextView
                            android:id="@+id/bookAuthors"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="author"
                            android:textColor="#4C4550"
                            android:textSize="13sp" />

                        <!-- app rating placeholder -->
                        <TextView
                            android:id="@+id/bookRating"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="☆☆☆☆☆"
                            android:textColor="#AD94C0"
                            android:textSize="16sp" />

                        <!-- add the book to the to be read list -->
                        <TextView
                            android:id="@+id/addToShelfButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/load_more_background"
                            android:gravity="center"
                            android:text="+ add to shelf"
                            android:textColor="#44374D"
                            android:textSize="12sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- add the book to the currently reading list -->
                        <TextView
                            android:id="@+id/currentlyReadingButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/load_more_background"
                            android:gravity="center"
                            android:text="currently reading"
                            android:textColor="#44374D"
                            android:textSize="12sp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </LinearLayout>

                <!-- synopsis -->
                <LinearLayout
                    android:id="@+id/synopsisPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/book_synopsis_background">

                    <TextView
                        android:id="@+id/synopsisHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="synopsis"
                        android:textColor="#332C37"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/bookDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="book description"
                        android:textColor="#4B4350"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="6"
                        android:ellipsize="end" />

                    <!-- expand or collapse the synopsis -->
                    <TextView
                        android:id="@+id/readMoreButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="read more ›"
                        android:textColor="#826B94"
                        android:textSize="12sp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- narrated synopsis audio player -->
                <LinearLayout
                    android:id="@+id/audioPlayerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/book_synopsis_background"
                    android:visibility="gone">

                    <!-- audio player heading -->
                    <TextView
                        android:id="@+id/audioHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="♫ listen to book preview"
                        android:textColor="#332C37"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/audioSubheading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="narrated synopsis"
                        android:textColor="#826B94"
                        android:textSize="12sp" />

                    <!-- audio playback progress -->
                    <SeekBar
                        android:id="@+id/audioSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:progressTint="#AD94C0"
                        android:thumbTint="#AD94C0"
                        android:progressBackgroundTint="#E5DCEB" />

                    <!-- elapsed and total playback time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/audioCurrentTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="#4B4350"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/audioTotalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="#4B4350"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- playback controls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingBottom="4dp">

                        <!-- rewind audio by ten seconds -->
                        <TextView
                            android:id="@+id/audioRewindButton"
                            android:layout_width="60dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:text="↶ 10"
                            android:textSize="15sp"
                            android:textColor="#826B94"
                            android:contentDescription="rewind ten seconds"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- play or pause the narration -->
                        <TextView
                            android:id="@+id/audioPlayPauseButton"
                            android:layout_width="100dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="14dp"
                            android:gravity="center"
                            android:text="play"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/audio_play_button_background"
                            android:contentDescription="play or pause audio"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- skip forward by ten seconds -->
                        <TextView
                            android:id="@+id/audioForwardButton"
                            android:layout_width="60dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:text="10 ↷"
                            android:textSize="15sp"
                            android:textColor="#826B94"
                            android:contentDescription="skip forward ten seconds"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ratings and reviews heading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★"
                        android:textColor="#AD94C0"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="ratings &amp; reviews"
                        android:textColor="#44374D"
                        android:textSize="18sp" />

                </LinearLayout>

                <!-- average app rating -->
                <TextView
                    android:id="@+id/averageRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#29232C"
                    android:textSize="40sp" />

                <RatingBar
                    android:id="@+id/averageRatingStars"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:numStars="5"
                    android:stepSize="0.5"
                    android:rating="0"
                    android:isIndicator="true"
                    android:progressTint="#AD94C0"
                    android:secondaryProgressTint="#E5D8E9"
                    android:progressBackgroundTint="#E5D8E9"
                    android:contentDescription="average app rating" />

                <TextView
                    android:id="@+id/reviewCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="app ratings not loaded"
                    android:textColor="#777777"
                    android:textSize="12sp" />

                <!-- allow the user to rate the book -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="rate this book"
                    android:textColor="#44374D"
                    android:textSize="14sp" />

                <RatingBar
                    android:id="@+id/bookReviewRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:numStars="5"
                    android:stepSize="1"
                    android:rating="0"
                    android:isIndicator="false"
                    android:progressTint="#AD94C0"
                    android:secondaryProgressTint="#E5D8E9"
                    android:progressBackgroundTint="#E5D8E9"
                    android:contentDescription="rate this book" />

                <!-- open the write review dialog -->
                <TextView
                    android:id="@+id/writeReviewButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/load_more_background"
                    android:gravity="center"
                    android:text="write a review"
                    android:textColor="#44374D"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- latest app reviews -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="latest app reviews"
                    android:textColor="#44374D"
                    android:textSize="16sp" />

                <!-- temporary example review content -->
                <LinearLayout
                    android:id="@+id/latestReviewsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:padding="10dp"
                        android:background="@drawable/profile_list_background">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="8dp"
                            android:background="@drawable/book_back_background"
                            android:src="@drawable/ic_profile"
                            android:contentDescription="example profile" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="example reader"
                                android:textColor="#44374D"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="★★★★☆"
                                android:textColor="#AD94C0"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Sample review — preview only."
                                android:textColor="#666666"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:padding="10dp"
                        android:background="@drawable/profile_list_background">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="8dp"
                            android:background="@drawable/book_back_background"
                            android:src="@drawable/ic_profile"
                            android:contentDescription="example profile" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="example reader"
                                android:textColor="#44374D"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="★★★★★"
                                android:textColor="#AD94C0"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="User reviews will appear here once connected."
                                android:textColor="#666666"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <include layout="@layout/bottom_navigation" />

</LinearLayout>