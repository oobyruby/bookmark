<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Purple header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#BCA9CC"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/book_view_header"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Scrollable book information -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Book cover -->
            <ImageView
                android:id="@+id/bookCover"
                android:layout_width="150dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#E8DDEC"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/book_cover_description" />

            <!-- Book title -->
            <TextView
                android:id="@+id/bookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/book_view_title"
                android:textColor="#333333"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Author -->
            <TextView
                android:id="@+id/bookAuthors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/book_view_author"
                android:textColor="#666666"
                android:textSize="15sp"
                android:gravity="center" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:background="#E0D6E6" />

            <!-- Description heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_view_about"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Book description -->
            <TextView
                android:id="@+id/bookDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/book_view_description"
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Existing bottom navigation -->
    <include layout="@layout/bottom_navigation" />

</LinearLayout>